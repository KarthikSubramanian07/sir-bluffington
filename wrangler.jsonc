{
  // Cloudflare Pages project config. Deploy with: npm run deploy
  // (which runs `wrangler pages deploy dist`). The project is static files plus one middleware:
  // the game runs client-side. The only server code is functions/_middleware.ts (Markdown
  // content negotiation and real 404s for agents); there is no D1, KV, or other binding.
  "name": "sirbluffington",
  "compatibility_date": "2025-01-01",
  "pages_build_output_dir": "dist"
}
